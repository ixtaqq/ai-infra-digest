# ─── Required ───────────────────────────────────────────
# Telegram Bot Token (get from @BotFather on Telegram)
# ⚠️  Never commit real credentials. Replace all placeholders before running.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID where the digest will be sent
# (Get it by messaging @userinfobot or checking bot updates)
TELEGRAM_CHAT_ID=

# ─── AI Provider (pick one) ─────────────────────────────
#
# Option A: Groq (FREE tier - recommended, ~1000 req/day)
# Sign up at https://console.groq.com (2-min signup, instant API key)
AI_PROVIDER=groq
AI_API_KEY=gsk_...
AI_MODEL=llama-3.3-70b-versatile

# Fast/cheap model for article classification (saves 40-60% on AI costs)
# Default: llama-3.1-8b-instant (works on Groq free tier)
# The strong model (AI_MODEL) handles synthesis; the fast model handles classification
AI_FAST_MODEL=llama-3.1-8b-instant

# Option B: OpenAI (paid, ~$0.50-2/month with gpt-4o-mini)
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Option C: OpenRouter (gateway to many models, has free tier)
# AI_PROVIDER=openrouter
# AI_API_KEY=...
# AI_MODEL=meta-llama/llama-3.3-70b-instruct

# Option D: Any OpenAI-compatible endpoint (Together, Fireworks, etc.)
# AI_PROVIDER=custom
# AI_API_KEY=...
# AI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ─── Earnings Transcript API (optional, for transcript mining) ──
# Roic.ai — Free tier: 5 req/min, 2-year history
# Sign up at https://www.roic.ai/api
ROIC_AI_API_KEY=

# ─── Budget caps (optional) ───────────────────────────────
# Sends a Telegram alert when daily / 30-day AI spend exceeds these thresholds.
# Groq free tier is extremely cheap (~$0.007/day); set lower if on paid plans.
AI_BUDGET_DAILY_USD=0.50
AI_BUDGET_MONTHLY_USD=5.00

# ─── Supabase (for dashboard) ───────────────────────────
# Create a free project at https://supabase.com
# Go to Settings → API to find these values
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# ─── Embeddings (Phase VIII) ────────────────────────────
# OpenAI key for text-embedding-3-small vectors stored in Supabase pgvector.
# Can share OPENAI_API_KEY if you're already using OpenAI as AI_PROVIDER.
OPENAI_EMBEDDING_API_KEY=sk-...

# ─── Slack (optional, additional delivery channel) ──────
# Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
# Leave empty to skip Slack delivery
SLACK_WEBHOOK_URL=

# ─── Gmail (optional, additional delivery channel) ──────
# Use Gmail App Password (not your account password)
# Enable 2FA first, then create App Password at https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
DIGEST_EMAIL_TO=recipient@example.com

# ─── Optional ───────────────────────────────────────────
# Malaysia timezone offset (UTC+8)
TZ=Asia/Kuala_Lumpur
