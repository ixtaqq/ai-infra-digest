# ─── Required ───────────────────────────────────────────
# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID where the digest will be sent
# (Get it by messaging @userinfobot or checking bot updates)
TELEGRAM_CHAT_ID=

# ─── AI Provider (pick one) ─────────────────────────────
#
# Option A: Groq (FREE tier - recommended, ~1000 req/day)
# Sign up at https://console.groq.com (2-min signup, instant API key)
AI_PROVIDER=groq
AI_API_KEY=gsk_...
AI_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI (paid, ~$0.50-2/month with gpt-4o-mini)
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Option C: OpenRouter (gateway to many models, has free tier)
# AI_PROVIDER=openrouter
# AI_API_KEY=...
# AI_MODEL=meta-llama/llama-3.3-70b-instruct

# Option D: Any OpenAI-compatible endpoint (Together, Fireworks, etc.)
# AI_PROVIDER=custom
# AI_API_KEY=...
# AI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ─── Optional ───────────────────────────────────────────
# Malaysia timezone offset (UTC+8)
TZ=Asia/Kuala_Lumpur
