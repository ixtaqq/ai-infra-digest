{
  "name": "ai-infra-digest",
  "version": "1.0.0",
  "description": "🚀 AI Infrastructure Daily Digest - Telegram bot delivering personalized AI infrastructure intelligence",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "node scripts/patch-node-telegram-bot-api.cjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test-digest": "tsx scripts/test-digest.ts",
    "preflight": "tsx scripts/preflight.ts",
    "preflight:network": "tsx scripts/preflight.ts --network",
    "retention-cleanup": "tsx scripts/run-retention-cleanup.ts",
    "scheduler": "tsx src/scheduler.ts",
    "webhook": "tsx src/webhook.ts",
    "start:webhook": "node dist/webhook.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest",
    "verify:website": "node scripts/verify-website.mjs",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:reset": "supabase db reset --local",
    "db:status": "supabase migration list"
  },
  "keywords": [
    "ai",
    "infrastructure",
    "telegram-bot",
    "news-digest",
    "stock-market"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-telegram-bot-api": "^1.1.1",
    "nodemailer": "^9.0.1",
    "openai": "^4.73.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/nodemailer": "^8.0.1",
    "supabase": "^2.107.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
