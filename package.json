  "description": "🚀 AI Infrastructure Daily Digest - Telegram bot delivering daily AI infra news at 8 AM Malaysia time",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test-digest": "tsx scripts/test-digest.ts",
    "lint": "tsc --noEmit",
